     mRdp->other_mode_l = (uint32_t)om;
     mRdp->other_mode_h = (uint32_t)(om >> 32);
+    if(previous_lut!=(mRdp->other_mode_h & G_TT_IA16))
+        mRdp->textures_changed[0]=mRdp->textures_changed[1]=true;
+
 }
 
