+
+// Complete only the source framebuffer's last submitted scene. The renderer
+// must fall back to glFinish when no valid tracked fence is available.
+int duck_vgl_wait_read_framebuffer(void) {
+    THREAD_SAFE()
+    if (!active_read_fb || !query_fence.address || duck_fence_wrap) return -1;
+    if (needs_end_scene && duck_scene_target == active_read_fb) {
+        dirty_framebuffer = GL_TRUE;
+        scene_reset();
+    }
+    uint32_t serial=duck_fence_lookup(&duck_framebuffer_fences,active_read_fb,query_fence.value);
+    if (!serial || duck_fence_wrap) return -1;
+    if (*query_fence.address < serial) {
+        SceGxmNotification required=query_fence;required.value=serial;
+        return sceGxmNotificationWait(&required);
+    }
+    return 0;
+}
